# ============================================================
# TopSpeak Backend — Contoh konfigurasi PRODUKSI (shared hosting)
# Salin ke server sebagai .env lalu sesuaikan nilainya.
# JANGAN commit .env asli ke git.
# ============================================================

APP_NAME=TopSpeak
APP_ENV=production
APP_KEY=                          # <-- WAJIB: `php artisan key:generate` di server
APP_DEBUG=false
# PENTING: harus menyertakan subfolder pakai path, mis. https://topexam.id/admintopspeak
APP_URL=https://topexam.id/admintopspeak

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --- Database (gunakan kredensial database dari hosting) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=topexam_admin
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# --- Duitku (isi dengan merchant code & api key asli saat ready) ---
DUITKU_MERCHANT_CODE=DUITKUDEMO
DUITKU_API_KEY=demo-api-key-000000
DUITKU_SANDBOX=true
DUITKU_NOTIFY_URL=https://topexam.id/admintopspeak/api/v1/subscriptions/duitku-callback
DUITKU_RETURN_URL=https://topexam.id/admintopspeak/subscription/result

# --- LLM Evaluator ---
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30